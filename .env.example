# Django secret key - generate a new one for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=False

# Your PythonAnywhere domain
ALLOWED_HOSTS=skorpion.pythonanywhere.com,localhost,127.0.0.1

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True only if you want to allow all origins (not recommended in production)
CORS_ALLOW_ALL_ORIGINS=False

# Android landing page download target and displayed app version.
# Keep the GitHub release asset named trendit.apk when using this default URL.
TRENDIT_APK_DOWNLOAD_URL=https://github.com/Imranxhah/Trendit/releases/latest/download/trendit.apk
TRENDIT_APP_VERSION=1.0.0

# ─── Cloudinary (Media Storage) ───────────────────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Cron Cleanup Endpoint ─────────────────────────────────────────────────────
# Used to secure /api/core/cleanup-media/ — set any long random string
CLEANUP_SECRET_TOKEN=change-this-to-a-long-random-string

# ─── Email Configuration ─────────────────────────────────────────────────────
# For Gmail, use an App Password, not your regular account password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Google Authentication
GOOGLE_CLIENT_ID_WEB=53818917564-5qs65vh7eqppccast1srdfprj0r3dafq.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=53818917564-53gagokm5p3ufbn5be122vms9uhih6bn.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=53818917564-77mlarkogqrhor9kbqaq8m25frvir6c3.apps.googleusercontent.com
CAPTION_MODERATION_ENABLED=True
CAPTION_MODERATION_ASSET_DIR=apps/content/moderation_assets
CAPTION_EXPORT_PSEUDONYM_KEY=

# ─── Sightengine Media Moderation ─────────────────────────────────────────────
# Sign up free at https://sightengine.com → Dashboard → API credentials
# Free tier: 2,000 image checks/month at no cost.
# Set MEDIA_MODERATION_ENABLED=False to disable in CI or local dev.
MEDIA_MODERATION_ENABLED=True
SIGHTENGINE_API_USER=your_api_user_here
SIGHTENGINE_API_SECRET=your_api_secret_here
# Block the post if raw nudity score exceeds this value (0.0–1.0).
SIGHTENGINE_BLOCK_THRESHOLD=0.6
# Flag the post for human review if raw nudity score exceeds this value.
SIGHTENGINE_REVIEW_THRESHOLD=0.3
